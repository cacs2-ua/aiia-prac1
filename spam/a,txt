sudo bash -c 'cat >/etc/systemd/system/frame-receiver.service' <<'EOF'
[Unit]
Description=FastAPI Frame Receiver
After=network.target

[Service]
User=azure-user
WorkingDirectory=/home/azure-user/apps/receiver
Environment="PATH=/home/azure-user/apps/receiver/.venv/bin"
ExecStart=/home/azure-user/apps/receiver/.venv/bin/uvicorn vm_receiver:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
EOF